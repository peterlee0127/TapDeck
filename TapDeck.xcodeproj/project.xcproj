{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "zh-Hant",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "Sources",
      "children": [
        {
          "kind": "group",
          "path": "TapDeck",
          "children": [
            { "path": "ActivityLog.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "AccessibilityController.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "ActionPerformer.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "GestureCoordinator.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "GestureModels.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "GestureRecognizer.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "LaunchAtLoginController.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "Localization.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "MenuBarController.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "MultitouchBridge.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "PreferencesStore.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "SettingsView.swift", "target-membership": [ "TapDeck/compile-sources" ] },
            { "path": "TapDeckApp.swift", "target-membership": [ "TapDeck/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Resources",
      "children": [
        { "path": "AppIcon.icns", "target-membership": [ "TapDeck/resources" ] },
        { "path": "AppIcon.png" },
        { "path": "Info.plist" },
        { "path": "Localizable.xcstrings", "target-membership": [ "TapDeck/resources" ] },
      ],
    }, {
      "kind": "group",
      "path": "Tests/TapDeckTests",
      "name": "Tests",
      "children": [
        { "path": "GestureRecognizerTests.swift", "target-membership": [ "TapDeckTests/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/AppKit.framework", "target-membership": [ "TapDeck/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/ApplicationServices.framework", "target-membership": [ "TapDeck/frameworks" ] },
      ],
    },
    { "path": "Package.swift" },
    { "path": "README.md" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/TapDeck Dev.app", "id": "A2000000000000000000000D", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TapDeckTests.xctest", "id": "A2000000000000000000000E", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "TapDeck",
      "id": "A70000000000000000000001",
      "product": "Products/TapDeck Dev.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "AWP2538424",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "EXECUTABLE_NAME": "TapDeck",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Resources/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "0.6.0",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "app.peterlee.tapdeck.debug",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "app.peterlee.tapdeck",
        "PRODUCT_MODULE_NAME": "TapDeck",
        "PRODUCT_NAME[config=Debug]": "TapDeck Dev",
        "PRODUCT_NAME[config=Release]": "TapDeck",
        "REGISTER_APP": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
      },
    }, {
      "name": "TapDeckTests",
      "id": "A70000000000000000000002",
      "product": "Products/TapDeckTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "TapDeck",
      "dependencies": [
        "TapDeck",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "DEAD_CODE_STRIPPING": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "app.peterlee.tapdeck.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TEST_HOST[config=Debug]": "$(BUILT_PRODUCTS_DIR)/TapDeck Dev.app/Contents/MacOS/TapDeck",
        "TEST_HOST[config=Release]": "$(BUILT_PRODUCTS_DIR)/TapDeck.app/Contents/MacOS/TapDeck",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP[config=Debug]": "NO",
    "COPY_PHASE_STRIP[config=Release]": "YES",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "26.6",
  "last-swift-update": "26.0",
}
